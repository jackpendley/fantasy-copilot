# Copy to .env.local and fill in. Never commit .env.local.

# ESPN fantasy (copy espn_s2 + SWID cookies from a logged-in browser:
# DevTools -> Application -> Cookies -> https://fantasy.espn.com; SWID keeps its {braces})
ESPN_S2=
ESPN_SWID={...}
ESPN_LEAGUE_ID=322514556
ESPN_TEAM_ID=13
ESPN_SEASON=2027

# Supabase (Project Settings -> API, and Project Settings -> Database -> connection string URI)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# App auth: APP_PASSWORD is what you type to log in; the secrets can each be `openssl rand -hex 32`
APP_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
