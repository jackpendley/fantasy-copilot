{
  "name": "fantasy-copilot",
  "private": true,
  "description": "Fantasy sports tools for winning ESPN leagues: draft copilots and a season-long team manager",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fantasy-copilot/nba-manager dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:sources": "pnpm --filter @fantasy-copilot/nba-data test:sources"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.9.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
